<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:Controls="clr-namespace:a7D.PDV.AutoAtendimento.UI.Controles"
    x:Class="a7D.PDV.AutoAtendimento.UI.Paginas.ReferenciaMesaPage"
    mc:Ignorable="d" 
    d:DesignHeight="600" 
    d:DesignWidth="800"
    Loaded="Page_Loaded">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="..\Controles\StyleButtons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Canvas>

        <TextBlock Name="Titulo" FontSize="26" HorizontalAlignment="Center">
            <TextBlock.Effect>
                <DropShadowEffect 
                    ShadowDepth="1" 
                    Direction="330" 
                    Color="White" 
                    Opacity="0.5" 
                    BlurRadius="5"/>
            </TextBlock.Effect>
            Informe o número da mesa
        </TextBlock>

        <TextBlock 
            Name="Numero"
            Text=""
            FontSize="42"
            FontWeight="Bold"
            TextAlignment="Center" />

        <Controls:TecladoBox 
            x:Name="Teclado" 
            Height="400" 
            Width="300" 
            Margin="0,30,0,0" 
            onChange="MesaNumero_Change" />

       <Button
            x:Name="ParaViagem"
            Content="PARA VIAGEM"
            Click="BtnParaViagem_Click" />

        <Button Name="Home" Click="Home_Click"/>

    </Canvas>
</Page>
